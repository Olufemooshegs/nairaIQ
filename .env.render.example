# Example Render environment variables
# WARNING: This is an example file. Do NOT commit real secrets to your repository.
# Set these values in the Render Dashboard (Environment -> Environment Variables).

# Database (use URL-encoded password)
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<URL_ENCODED_PASSWORD>@db.wyckajfmgehgenlajkmp.supabase.co:5432/postgres

# App secrets
SECRET_KEY=<generate-a-secure-secret>
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Supabase (server-only values must be stored in Render and never exposed to frontend)
SUPABASE_URL=https://wyckajfmgehgenlajkmp.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>  # SERVER ONLY
SUPABASE_AVATAR_BUCKET=avatars

# CORS: comma-separated list of allowed origins
# Include local dev and your frontend domain(s)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
