# Example Vercel environment variables (frontend)
# WARNING: Do NOT store server-side secrets here. Only public anon keys belong here.

# Backend API base used by the frontend API client
VITE_API_BASE_URL=https://<your-backend-domain>/api/v1

# Optional: public Supabase anon key for client-side limited operations
VITE_SUPABASE_ANON_KEY=<anon-key>

# Keep the Supabase service role key only on the backend (Render or other server host)
